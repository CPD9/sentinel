# Copy to .env (gitignored) and fill in. Never commit real values.
# SENTINEL_ALLOW_REMOTE_LLM is NOT read from this file on purpose: set it per shell or per command.

# --- LLM: self-hosted default (apertus_aws) ---
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=swiss-ai/Apertus-v1.5-8B

# --- LLM: OpenRouter (remote, fictional data only) ---
OPENROUTER_API_KEY=

# --- Optional: Infomaniak (remote, CH) ---
# INFOMANIAK_PRODUCT_ID=
# INFOMANIAK_API_TOKEN=

# --- Provider choice: leave commented to keep apertus_aws as the default ---
# SENTINEL_LLM_PROVIDER=openrouter

# --- Rest of the pipeline ---
HF_TOKEN=
ASR_MODEL_PATH=large-v3-turbo
DATA_DIR=./data
TRIGGER_URL=