{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(ls *)",
      "Bash(ffprobe *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git merge origin/main)",
      "Bash(git merge --no-edit origin/main)",
      "Bash(git push origin web/*)",
      "Bash(git push -u origin web/*)",
      "Bash(git push origin ml/*)",
      "Bash(git push -u origin ml/*)",
      "Bash(git push origin api/*)",
      "Bash(git push -u origin api/*)",
      "Bash(git push origin infra/*)",
      "Bash(git push -u origin infra/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr create*)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view*)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(docker *)",
      "Bash(pip install *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add -u*)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *-a *)",
      "Bash(git commit *--all*)",
      "Bash(git push)",
      "Bash(git push *main*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--tags*)",
      "Bash(git push *:*)",
      "Bash(git rebase *)",
      "Bash(git rebase)",
      "Bash(git reset *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./data/**)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh workflow *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)"
    ]
  }
}
