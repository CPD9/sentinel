{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(ls *)",
      "Bash(ffprobe *)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(docker *)",
      "Bash(pip install *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Bash(gh *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./data/**)"
    ]
  }
}
